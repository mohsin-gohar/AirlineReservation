@model AirlineReservation.Models.RegisterViewModel
@{ ViewData["Title"] = "Create Account"; }
<div class="auth-wrap">
    <div class="auth-side">
        <div class="bg" style="background-image:url('https://images.unsplash.com/photo-1488085061387-422e29b40080?auto=format&fit=crop&w=1200&q=70')"></div>
        <a class="brand" asp-controller="Home" asp-action="Index" style="align-self:flex-start">
            <span class="brand-logo" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21.5 15.5l-8.1-4.7V4.8c0-.9-.6-2.3-1.4-2.3s-1.4 1.4-1.4 2.3v6L2.5 15.5v2.1l8.1-2.5v4.6l-2.2 1.6v1.5l3.6-1 3.6 1v-1.5l-2.2-1.6v-4.6l8.1 2.5v-2.1z"/></svg></span>
            <span><span class="brand-name">SkyPulse</span><span class="brand-sub">AIRLINES</span></span>
        </a>
        <div class="auth-quote reveal in">
            "Join SkyPulse and earn SkyMiles from your very first flight."
            <small>Free fare holds · member pricing · priority offers.</small>
        </div>
    </div>
    <div class="auth-main">
        <div class="auth-card">
            <span class="eyebrow">Join SkyPulse</span>
            <h1 style="font-size:1.9rem">Create your account</h1>
            <p class="text-muted">Two minutes now, smoother skies forever.</p>
            <div class="panel">
                <form asp-action="Register" method="post">
                    <div asp-validation-summary="All" class="validation-summary-errors"></div>
                    <div class="input-group" style="margin-bottom:16px">
                        <div class="field" style="flex:1">
                            <label asp-for="FirstName">First name</label>
                            <input asp-for="FirstName" class="input" autocomplete="given-name" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="field" style="flex:1">
                            <label asp-for="LastName">Last name</label>
                            <input asp-for="LastName" class="input" autocomplete="family-name" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="field" style="margin-bottom:16px">
                        <label asp-for="Email">Email</label>
                        <input asp-for="Email" class="input" type="email" autocomplete="email" placeholder="you@example.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="field" style="margin-bottom:20px">
                        <label asp-for="Password">Password</label>
                        <input asp-for="Password" class="input" type="password" autocomplete="new-password" placeholder="Minimum 8 characters" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <button class="btn btn-primary" type="submit" style="width:100%">Create account</button>
                </form>
            </div>
            <p class="auth-alt">Already a member? <a asp-action="Login">Sign in</a></p>
        </div>
    </div>
</div>