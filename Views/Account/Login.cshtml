@{ ViewData["Title"] = "Sign In"; }
<div class="auth-wrap">
    <div class="auth-side">
        <div class="bg" style="background-image:url('https://images.unsplash.com/photo-1488085061387-422e29b40080?auto=format&fit=crop&w=1200&q=70')"></div>
        <a class="brand" asp-controller="Home" asp-action="Index" style="align-self:flex-start">
            <span class="brand-logo" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21.5 15.5l-8.1-4.7V4.8c0-.9-.6-2.3-1.4-2.3s-1.4 1.4-1.4 2.3v6L2.5 15.5v2.1l8.1-2.5v4.6l-2.2 1.6v1.5l3.6-1 3.6 1v-1.5l-2.2-1.6v-4.6l8.1 2.5v-2.1z"/></svg></span>
            <span><span class="brand-name">SkyPulse</span><span class="brand-sub">AIRLINES</span></span>
        </a>
        <div class="auth-quote reveal in">
            "Every journey begins with a single boarding pass."
            <small>The SkyPulse promise — flexible fares, human support, premium skies.</small>
        </div>
    </div>
    <div class="auth-main">
        <div class="auth-card">
            <span class="eyebrow">Member portal</span>
            <h1 style="font-size:1.9rem">Welcome back</h1>
            <p class="text-muted">Sign in to manage bookings, fare holds, and SkyMiles.</p>
            <div class="panel">
                <form asp-action="Login" method="post">
                    <div asp-validation-summary="All" class="validation-summary-errors"></div>
                    <div class="field mb-3" style="margin-bottom:16px">
                        <label for="email">Email</label>
                        <input class="input" id="email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" />
                    </div>
                    <div class="field" style="margin-bottom:20px">
                        <label for="password">Password</label>
                        <input class="input" id="password" name="password" type="password" required autocomplete="current-password" placeholder="••••••••" />
                    </div>
                    <button class="btn btn-primary" type="submit" style="width:100%">Sign in</button>
                </form>
            </div>
            <p class="auth-alt">New to SkyPulse? <a asp-action="Register">Create an account</a></p>
            <p class="auth-alt" style="margin-top:-8px"><span class="hint">Demo admin: demo&#64;example.com · ChangeMe123!</span></p>
        </div>
    </div>
</div>