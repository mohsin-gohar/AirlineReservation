@model AirlineReservation.Models.Booking
@using AirlineReservation.Models
@{ ViewData["Title"] = "Booking Status"; }
@if (Model == null)
{
    <section class="dark-banner compact">
        <div class="banner-inner">
            <span class="eyebrow on-dark">Ticket status</span>
            <h1>Find your booking</h1>
            <p>Look up any reservation with its confirmation or blocking number.</p>
        </div>
    </section>
    <div class="page page-narrow" style="margin-top:calc(-1*var(--s6))">
        <div class="panel reveal in" style="position:relative;z-index:3;box-shadow:var(--shadow-md)">
            <form asp-action="Status" method="get">
                <div asp-validation-summary="All" class="validation-summary-errors"></div>
                <div class="field">
                    <label for="reference">Booking reference</label>
                    <input class="input" id="reference" name="reference" placeholder="e.g. AW-847291 or BLK-492017" />
                    <span class="hint">Your reference was shown when the booking was created. Sign in to manage your own bookings.</span>
                </div>
                <button class="btn btn-primary mt-2" type="submit">Look up booking</button>
            </form>
        </div>
    </div>
}
else
{
    var reference = Model.ConfirmationNumber ?? Model.BlockingNumber ?? $"#{Model.BookingId}";
    var badge = Model.BookingStatus switch
    {
        BookingStatus.Active => Model.BookingType == BookingType.Blocked ? "badge-blocked" : "badge-confirmed",
        BookingStatus.Cancelled => "badge-cancelled",
        _ => "badge-rescheduled"
    };
    var isActive = Model.BookingStatus == BookingStatus.Active;
    var isOwner = (Context.Session.GetInt32("UserId") ?? 0) == Model.UserId;
    var canManage = isOwner && isActive;
    <section class="dark-banner compact">
        <div class="banner-inner">
            <span class="eyebrow on-dark">E-ticket · @Model.Flight?.FlightNumber</span>
            <h1>@Model.Flight?.OriginCity?.CityName → @Model.Flight?.DestinationCity?.CityName</h1>
            <p>@Model.DepartureDate.ToString("dddd, MMMM dd, yyyy") · @Model.PassengerCount traveler(s)</p>
        </div>
    </section>
    <div class="page" style="margin-top:calc(-1*var(--s6))">
        <div class="boarding-pass reveal in" style="position:relative;z-index:3">
            <div class="bp-top">
                <span class="bp-brand"><span class="brand-logo" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21.5 15.5l-8.1-4.7V4.8c0-.9-.6-2.3-1.4-2.3s-1.4 1.4-1.4 2.3v6L2.5 15.5v2.1l8.1-2.5v4.6l-2.2 1.6v1.5l3.6-1 3.6 1v-1.5l-2.2-1.6v-4.6l8.1 2.5v-2.1z"/></svg></span>SkyPulse Airlines</span>
                <span class="badge-status @badge">@Model.BookingStatus@(Model.BookingType == BookingType.Blocked && isActive ? " · fare hold" : "")</span>
            </div>
            <div class="bp-body">
                <div class="bp-main">
                    <div class="bp-route">
                        <div class="pt"><b>@(Model.Flight?.OriginAirport?.Code ?? Model.Flight?.OriginCity?.CityName)</b><small>@Model.Flight?.OriginCity?.CityName</small></div>
                        <div class="mid">
                            <small>@Model.Flight?.Duration · non-stop</small>
                            <div class="line"><svg viewBox="0 0 24 24"><path d="M21.5 15.5l-8.1-4.7V4.8c0-.9-.6-2.3-1.4-2.3s-1.4 1.4-1.4 2.3v6L2.5 15.5v2.1l8.1-2.5v4.6l-2.2 1.6v1.5l3.6-1 3.6 1v-1.5l-2.2-1.6v-4.6l8.1 2.5v-2.1z"/></svg></div>
                            <small>@Model.Flight?.DepartureDate.ToString("MMM dd, yyyy")</small>
                        </div>
                        <div class="pt" style="text-align:right"><b>@(Model.Flight?.DestinationAirport?.Code ?? Model.Flight?.DestinationCity?.CityName)</b><small>@Model.Flight?.DestinationCity?.CityName</small></div>
                    </div>
                    <div class="bp-grid">
                        <div><small>Departs</small><b>@Model.Flight?.DepartureTime.ToString(@"hh\:mm")</b></div>
                        <div><small>Arrives</small><b>@Model.Flight?.ArrivalTime.ToString(@"hh\:mm")</b></div>
                        <div><small>Cabin</small><b>Economy</b></div>
                        <div><small>Travelers</small><b>@Model.PassengerCount</b></div>
                    </div>
                </div>
                <div class="bp-stub">
                    <small style="font-size:.66rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-400);font-weight:700">@(Model.BookingType == BookingType.Blocked ? "Blocking number" : "Confirmation number")</small>
                    <span class="ref">@reference</span>
                    <div class="barcode" aria-hidden="true">@for (var i = 0; i < 24; i++) { <i></i> }</div>
                    <small style="font-size:.78rem;color:var(--ink-500)">Total @(Model.BookingType == BookingType.Blocked && isActive ? "due at confirmation" : "paid"): <b>@Model.TotalPrice.ToString("C")</b></small>
                </div>
            </div>
        </div>
        <div class="bp-actions">
            @if (isOwner)
            {
                <a class="btn btn-ghost btn-sm" asp-action="MyBookings">My bookings</a>
            }
            @if (canManage && Model.BookingType == BookingType.Blocked)
            {
                <form asp-action="Confirm" method="post">
                    <input type="hidden" name="blockingNumber" value="@Model.BlockingNumber" />
                    <button class="btn btn-primary btn-sm" type="submit">Confirm hold · @Model.TotalPrice.ToString("C")</button>
                </form>
            }
            @if (canManage)
            {
                <a class="btn btn-ghost btn-sm" asp-action="Reschedule" asp-route-id="@Model.BookingId">Reschedule</a>
                <form asp-action="Cancel" method="post" asp-route-id="@Model.BookingId" data-confirm data-confirm-message="Cancel booking @reference? Policy-based refunds apply and seats will be released.">
                    <button class="btn btn-danger btn-sm" type="submit">Cancel booking</button>
                </form>
                <a class="btn btn-ghost btn-sm" asp-action="CheckIn">Check-in</a>
            }
            @if (Model.IsCheckedIn)
            {
                <span class="badge-status badge-arrived">Checked in @((Model.CheckedInAt ?? DateTime.UtcNow).ToString("MMM d, h:mm a UTC"))</span>
            }
            <a class="btn btn-light btn-sm" asp-controller="Flight" asp-action="Search">Book another flight</a>
        </div>
    </div>
}