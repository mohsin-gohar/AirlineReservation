@model IEnumerable<AirlineReservation.Models.Booking>
@using AirlineReservation.Models
@{ ViewData["Title"] = "My Bookings"; }
<section class="dark-banner compact">
    <div class="banner-inner">
        <span class="eyebrow on-dark">Passenger portal</span>
        <h1>My bookings</h1>
        <p>View, confirm, reschedule, or cancel your journeys — all in one place.</p>
    </div>
</section>
<div class="page">
    <div class="section-head reveal">
        <div><span class="eyebrow">Your reservations</span><h2 style="font-size:1.4rem;margin:0">@(Model?.Count() ?? 0) booking(s)</h2></div>
        <a class="btn btn-primary btn-sm" asp-controller="Flight" asp-action="Search">Book a flight</a>
    </div>
    @if (Model == null || !Model.Any())
    {
        <div class="empty-state reveal in">
            <div class="icon"><svg viewBox="0 0 24 24"><path d="M21.5 15.5l-8.1-4.7V4.8c0-.9-.6-2.3-1.4-2.3s-1.4 1.4-1.4 2.3v6L2.5 15.5v2.1l8.1-2.5v4.6l-2.2 1.6v1.5l3.6-1 3.6 1v-1.5l-2.2-1.6v-4.6l8.1 2.5v-2.1z"/></svg></div>
            <h3>No bookings yet</h3>
            <p>Your reserved and purchased trips will appear here. Start by searching for a flight.</p>
            <a class="btn btn-primary btn-sm" asp-controller="Flight" asp-action="Search">Find a flight</a>
        </div>
    }
    else
    {
        <div class="booking-cards">
            @foreach (var b in Model)
            {
                var reference = b.ConfirmationNumber ?? b.BlockingNumber ?? $"#{b.BookingId}";
                var badge = b.BookingStatus switch
                {
                    BookingStatus.Active => b.BookingType == BookingType.Blocked ? "badge-blocked" : "badge-confirmed",
                    BookingStatus.Cancelled => "badge-cancelled",
                    _ => "badge-rescheduled"
                };
                <article class="bcard reveal">
                    <div>
                        <div class="bcard-route">
                            <span class="code">@(b.Flight?.OriginAirport?.Code ?? b.Flight?.OriginCity?.CityName)</span>
                            <span class="dash"><svg viewBox="0 0 24 24"><path d="M21.5 15.5l-8.1-4.7V4.8c0-.9-.6-2.3-1.4-2.3s-1.4 1.4-1.4 2.3v6L2.5 15.5v2.1l8.1-2.5v4.6l-2.2 1.6v1.5l3.6-1 3.6 1v-1.5l-2.2-1.6v-4.6l8.1 2.5v-2.1z"/></svg></span>
                            <span class="code">@(b.Flight?.DestinationAirport?.Code ?? b.Flight?.DestinationCity?.CityName)</span>
                            <span class="badge-status @badge">@b.BookingStatus@(b.BookingType == BookingType.Blocked && b.BookingStatus == BookingStatus.Active ? " · hold" : "")</span>
                        </div>
                        <div class="bcard-meta">
                            <div><span>Reference</span><b><span class="ref-chip">@reference</span></b></div>
                            <div><span>Flight</span><b>SkyPulse @b.Flight?.FlightNumber</b></div>
                            <div><span>Departs</span><b>@b.DepartureDate.ToString("ddd, MMM dd, yyyy")</b></div>
                            <div><span>Travelers</span><b>@b.PassengerCount</b></div>
                        </div>
                    </div>
                    <div class="bcard-side">
                        <span class="amount">@(b.BookingType == BookingType.Blocked && b.BookingStatus == BookingStatus.Active ? "Hold" : b.TotalPrice.ToString("C"))</span>
                        <div class="bcard-actions">
                            <a class="btn btn-ghost btn-sm" asp-action="Status" asp-route-id="@b.BookingId">View ticket</a>
                            @if (b.BookingStatus == BookingStatus.Active && b.BookingType == BookingType.Blocked)
                            {
                                <form asp-action="Confirm" method="post">
                                    <input type="hidden" name="blockingNumber" value="@b.BlockingNumber" />
                                    <button class="btn btn-primary btn-sm" type="submit">Confirm · @b.TotalPrice.ToString("C")</button>
                                </form>
                            }
                            @if (b.BookingStatus == BookingStatus.Active)
                            {
                                <a class="btn btn-ghost btn-sm" asp-action="Reschedule" asp-route-id="@b.BookingId">Reschedule</a>
                                <form asp-action="Cancel" method="post" asp-route-id="@b.BookingId" data-confirm data-confirm-message="Cancel booking @reference? Policy-based refunds apply and seats will be released.">
                                    <button class="btn btn-danger btn-sm" type="submit">Cancel</button>
                                </form>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>