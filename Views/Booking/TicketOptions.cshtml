@model (AirlineReservation.Models.BookingRequest Request, AirlineReservation.Models.Flight Flight)
@{
    ViewData["Title"] = "Choose Ticket Option";
    var req = Model.Request;
    var flight = Model.Flight;
    var pax = req.PassengerCount;
    var total = flight.TicketPrice * pax;
    var canBlock = flight.Departure > DateTime.Now.AddDays(14);
}
<section class="dark-banner compact">
    <div class="banner-inner">
        <span class="eyebrow on-dark">Review &amp; choose · @flight.FlightNumber</span>
        <h1>How would you like to book?</h1>
        <p>@flight.OriginCity?.CityName → @flight.DestinationCity?.CityName · @flight.DepartureDate.ToString("dddd, MMMM dd, yyyy") · @pax traveler(s)</p>
    </div>
</section>
<div class="steps" aria-label="Booking progress">
    <div class="step done"><span class="step-dot"><svg viewBox="0 0 24 24"><path d="M9 16.2l-3.5-3.5-1.4 1.4 4.9 4.9L20.3 7.7l-1.4-1.4z"/></svg></span><small>Flight</small></div>
    <div class="step done"><span class="step-dot"><svg viewBox="0 0 24 24"><path d="M9 16.2l-3.5-3.5-1.4 1.4 4.9 4.9L20.3 7.7l-1.4-1.4z"/></svg></span><small>Passenger</small></div>
    <div class="step current"><span class="step-dot">3</span><small>Review</small></div>
    <div class="step"><span class="step-dot">4</span><small>Confirmation</small></div>
</div>
<div class="page">
    <div class="booking-layout">
        <div class="booking-main">
            <div class="option-grid">
                <div class="option-card reveal">
                    <span class="flag">Zero-cost hold</span>
                    <span class="eyebrow">Block ticket</span>
                    <h3>Reserve now, pay later</h3>
                    <div class="price-line">No charge today <small>· hold expires 14 days before departure</small></div>
                    <ul class="option-feats">
                        <li><svg viewBox="0 0 24 24"><path d="M9 16.2l-3.5-3.5-1.4 1.4 4.9 4.9L20.3 7.7l-1.4-1.4z"/></svg>Fare and seats locked for your party</li>
                        <li><svg viewBox="0 0 24 24"><path d="M9 16.2l-3.5-3.5-1.4 1.4 4.9 4.9L20.3 7.7l-1.4-1.4z"/></svg>Confirm any time with one click</li>
                        <li><svg viewBox="0 0 24 24"><path d="M9 16.2l-3.5-3.5-1.4 1.4 4.9 4.9L20.3 7.7l-1.4-1.4z"/></svg>Automatic reminder before expiry</li>
                    </ul>
                    @if (!canBlock)
                    {
                        <div class="option-note">Departure is within 14 days — blocking is unavailable for this flight. Purchase is required.</div>
                    }
                    <form asp-action="Block" method="post">
                        <input asp-for="Request.FlightId" type="hidden" />
                        <input asp-for="Request.NumberOfAdults" type="hidden" />
                        <input asp-for="Request.NumberOfChildren" type="hidden" />
                        <input asp-for="Request.NumberOfSeniors" type="hidden" />
                        <button class="btn btn-ghost" type="submit" style="width:100%" disabled="@(canBlock ? null : "disabled")">Block this ticket</button>
                    </form>
                </div>
                <div class="option-card recommended reveal">
                    <span class="flag">Recommended</span>
                    <span class="eyebrow">Buy ticket</span>
                    <h3>Instant e-ticket</h3>
                    <div class="price-line">@total.ToString("C") <small>· charged once today</small></div>
                    <ul class="option-feats">
                        <li><svg viewBox="0 0 24 24"><path d="M9 16.2l-3.5-3.5-1.4 1.4 4.9 4.9L20.3 7.7l-1.4-1.4z"/></svg>Immediate confirmation and e-ticket</li>
                        <li><svg viewBox="0 0 24 24"><path d="M9 16.2l-3.5-3.5-1.4 1.4 4.9 4.9L20.3 7.7l-1.4-1.4z"/></svg>SkyMiles earned on the full fare</li>
                        <li><svg viewBox="0 0 24 24"><path d="M9 16.2l-3.5-3.5-1.4 1.4 4.9 4.9L20.3 7.7l-1.4-1.4z"/></svg>Eligible for policy-based refunds</li>
                    </ul>
                    <form asp-action="Buy" method="post">
                        <input asp-for="Request.FlightId" type="hidden" />
                        <input asp-for="Request.NumberOfAdults" type="hidden" />
                        <input asp-for="Request.NumberOfChildren" type="hidden" />
                        <input asp-for="Request.NumberOfSeniors" type="hidden" />
                        <div class="field">
                            <label asp-for="Request.CreditCardNumber">Card number</label>
                            <input asp-for="Request.CreditCardNumber" class="input" inputmode="numeric" autocomplete="cc-number" placeholder="4242 4242 4242 4242" />
                        </div>
                        <button class="btn btn-primary" type="submit" style="width:100%">Confirm purchase</button>
                        <p class="hint mt-2 mb-0" style="text-align:center">Demo checkout — no real payment is processed.</p>
                    </form>
                </div>
            </div>
        </div>
        <aside class="booking-aside">
            <div class="aside-card">
                <h3>Trip summary</h3>
                <div class="mini-route">
                    <span class="code">@(flight.OriginAirport?.Code ?? flight.OriginCity?.CityName)</span>
                    <span class="dash"><svg viewBox="0 0 24 24"><path d="M21.5 15.5l-8.1-4.7V4.8c0-.9-.6-2.3-1.4-2.3s-1.4 1.4-1.4 2.3v6L2.5 15.5v2.1l8.1-2.5v4.6l-2.2 1.6v1.5l3.6-1 3.6 1v-1.5l-2.2-1.6v-4.6l8.1 2.5v-2.1z"/></svg></span>
                    <span class="code">@(flight.DestinationAirport?.Code ?? flight.DestinationCity?.CityName)</span>
                </div>
                <div class="fare-row"><span>Date</span><span>@flight.DepartureDate.ToString("MMM dd, yyyy")</span></div>
                <div class="fare-row"><span>Departure</span><span>@flight.DepartureTime.ToString(@"hh\:mm") · @flight.Duration</span></div>
                <div class="fare-row"><span>Travelers</span><span>@pax</span></div>
            </div>
            <div class="aside-card">
                <h3>Passengers</h3>
                <ul class="pax-list">
                    @foreach (var p in req.Passengers) { <li><svg viewBox="0 0 24 24"><path d="M12 12a5 5 0 10-5-5 5 5 0 005 5zm0 2c-3.3 0-10 1.7-10 5v3h20v-3c0-3.3-6.7-5-10-5z"/></svg>@p.FirstName @p.LastName</li> }
                </ul>
            </div>
            <div class="aside-card">
                <h3>Fare breakdown</h3>
                <div class="fare-row"><span>@flight.TicketPrice.ToString("C") × @pax</span><span>@total.ToString("C")</span></div>
                <div class="fare-row"><span>Taxes &amp; fees</span><span>Included</span></div>
                <div class="fare-row total"><span>Total</span><span>@total.ToString("C")</span></div>
            </div>
        </aside>
        </div>
    </div>
</div>