@using AirlineReservation.Models
@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="error-wrap">
    <div class="reveal in" style="max-width:520px">
        <div class="error-code">Oops</div>
        <h1 style="font-size:1.6rem">We hit some turbulence</h1>
        <p class="text-muted">An error occurred while processing your request. It has been noted — please try again.</p>
        @if (Model?.ShowRequestId == true)
        {
            <p class="hint">Request ID: <code>@Model.RequestId</code></p>
        }
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:24px">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
            <a class="btn btn-ghost" asp-controller="Flight" asp-action="Search">Search flights</a>
        </div>
    </div>
</div>