@using Microsoft.AspNetCore.Http
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var isHome = controller == "Home" && action == "Index";
    var uid = Context.Session.GetInt32("UserId");
    var uname = Context.Session.GetString("UserName");
    var urole = Context.Session.GetInt32("UserRole");
    var initials = string.Join("", (uname ?? "S").Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(p => p[0])).ToUpperInvariant();
    string Active(string c, string? a = null) => controller == c && (a == null || action == a) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " · " : "")SkyPulse Airlines</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/motion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/marketing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/flights.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/booking.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tickets.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/extras.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body class="@(isHome ? "nav-overlay" : "")" data-toast-message="@TempData["Message"]" data-toast-error="@TempData["Error"]">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-nav">
        <nav class="page-nav" aria-label="Main navigation">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="SkyPulse Airlines home">
                <span class="brand-logo" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21.5 15.5l-8.1-4.7V4.8c0-.9-.6-2.3-1.4-2.3s-1.4 1.4-1.4 2.3v6L2.5 15.5v2.1l8.1-2.5v4.6l-2.2 1.6v1.5l3.6-1 3.6 1v-1.5l-2.2-1.6v-4.6l8.1 2.5v-2.1z"/></svg></span>
                <span><span class="brand-name">SkyPulse</span><span class="brand-sub">AIRLINES</span></span>
            </a>
            <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="navMenu" aria-label="Toggle menu"><span></span></button>
            <div class="nav-menu" id="navMenu">
                <ul class="nav-links">
                    <li><a class="nav-link @Active("Home","Index")" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a class="nav-link @Active("Flight","Search")" asp-controller="Flight" asp-action="Search">Book a Flight</a></li>
                    @if (uid == null)
                    {
                        <li><a class="nav-link @Active("Booking","CheckIn")" asp-controller="Booking" asp-action="CheckIn">Check-in</a></li>
                    }
                    <li><a class="nav-link @Active("Home","About")" asp-controller="Home" asp-action="About">About</a></li>
                    <li><a class="nav-link @Active("Home","Contact")" asp-controller="Home" asp-action="Contact">Contact</a></li>
                    @if (uid != null)
                    {
                        <li class="nav-divider"></li>
                        <li><a class="nav-link nav-accent @Active("Booking","MyBookings")" asp-controller="Booking" asp-action="MyBookings">My Bookings</a></li>
                        <li><a class="nav-link nav-accent @Active("Booking","CheckIn")" asp-controller="Booking" asp-action="CheckIn">Check-in</a></li>
                        <li><a class="nav-link nav-accent @Active("Profile")" asp-controller="Profile" asp-action="Index">SkyMiles</a></li>
                    }
                </ul>
                <div class="nav-auth">
                    @if (uid == null)
                    {
                        <a class="btn btn-ghost btn-sm" asp-controller="Account" asp-action="Login">Sign in</a>
                        <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Create account</a>
                    }
                    else
                    {
                        @if (urole == (int)AirlineReservation.Models.UserRole.Admin)
                        {
                            <a class="btn btn-ghost btn-sm" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a>
                        }
                        <a class="nav-greet" asp-controller="Profile" asp-action="Index">
                            <span class="avatar-dot">@initials</span>
                            <span><b>@uname</b><small>SkyPulse member</small></span>
                        </a>
                        <a class="btn btn-light btn-sm" asp-controller="Account" asp-action="Logout">Sign out</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <main id="main">@RenderBody()</main>
<footer class="site-footer">
    <div class="footer-grid">
        <div>
            <a class="footer-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-logo" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21.5 15.5l-8.1-4.7V4.8c0-.9-.6-2.3-1.4-2.3s-1.4 1.4-1.4 2.3v6L2.5 15.5v2.1l8.1-2.5v4.6l-2.2 1.6v1.5l3.6-1 3.6 1v-1.5l-2.2-1.6v-4.6l8.1 2.5v-2.1z"/></svg></span>
                <span><span class="brand-name">SkyPulse</span><span class="brand-sub">AIRLINES</span></span>
            </a>
            <p class="footer-desc">Premium travel across 120+ destinations with flexible fare holds, transparent pricing, and human support at every altitude.</p>
            <div class="footer-trust"><span>IATA MEMBER</span><span>PCI-DSS SECURED</span><span>ISO 27001</span></div>
        </div>
        <div>
            <h6>Travel</h6>
            <a asp-controller="Flight" asp-action="Search">Book a flight</a>
            <a asp-controller="Booking" asp-action="MyBookings">My bookings</a>
            <a asp-controller="Booking" asp-action="CheckIn">Online check-in</a>
            <a asp-controller="Flight" asp-action="Status">Flight status</a>
            <a asp-controller="Home" asp-action="Destinations">Destinations</a>
        </div>
        <div>
            <h6>Company</h6>
            <a asp-controller="Home" asp-action="About">About SkyPulse</a>
            <a asp-controller="Home" asp-action="Offers">Offers &amp; fares</a>
            <a asp-controller="Home" asp-action="Contact">Contact</a>
            <a asp-controller="Home" asp-action="Privacy">Privacy policy</a>
        </div>
        <div>
            <h6>24/7 Support</h6>
            <a href="tel:+18008923776">+1 (800) 892-ERGO</a>
            <a href="mailto:care@skypulse.example">care&#64;skypulse.example</a>
            <p class="footer-desc" style="margin-top:12px">Our dispatch desk is online around the clock for rebooking, fare holds, and accessibility assistance.</p>
        </div>
    </div>
    <div class="footer-bottom">
        <div class="footer-bottom-inner">
            <span>© 2026 SkyPulse Airlines. All rights reserved.</span>
            <nav aria-label="Legal">
                <a asp-controller="Home" asp-action="About">About</a>
                <a asp-controller="Home" asp-action="Contact">Contact</a>
                <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            </nav>
        </div>
    </div>
</footer>
<div id="toastStack" aria-live="polite"></div>
<div id="skeletonOverlay" aria-hidden="true">
    <div class="sk-card">
        <div class="sk-row"><div class="sk-plane"><svg viewBox="0 0 24 24"><path d="M21.5 15.5l-8.1-4.7V4.8c0-.9-.6-2.3-1.4-2.3s-1.4 1.4-1.4 2.3v6L2.5 15.5v2.1l8.1-2.5v4.6l-2.2 1.6v1.5l3.6-1 3.6 1v-1.5l-2.2-1.6v-4.6l8.1 2.5v-2.1z"/></svg></div><div class="sk-line skeleton" style="flex:1"></div></div>
        <div class="sk-line skeleton" style="width:78%"></div>
        <div class="sk-line skeleton" style="width:64%"></div>
        <div class="sk-line skeleton" style="width:71%"></div>
    </div>
    <span class="sk-loading-text">Searching live schedules…</span>
</div>
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true" aria-labelledby="confirmTitle">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title" id="confirmTitle">Please confirm</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body"></div>
        <div class="modal-footer">
            <button type="button" class="btn btn-ghost btn-sm" data-bs-dismiss="modal">Keep it</button>
            <button type="button" class="btn btn-primary btn-sm" id="confirmOk">Yes, continue</button>
        </div>
    </div></div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>