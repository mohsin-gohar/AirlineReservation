@{ ViewData["Title"] = "About"; }
<section class="dark-banner compact">
    <div class="banner-inner">
        <span class="eyebrow on-dark">The SkyPulse standard</span>
        <h1>Built for journeys that matter.</h1>
        <p>We connect people and places with dependable aircraft, transparent fares, and human support at every altitude.</p>
    </div>
</section>
<div class="page" style="margin-top:calc(-1*var(--s6))">
    <div class="stats-grid reveal in" style="position:relative;z-index:3;background:#fff;border:1px solid var(--line);border-radius:var(--r-lg);box-shadow:var(--shadow-md);grid-template-columns:repeat(3,1fr)">
        <div class="stat"><b><span data-count="140" data-suffix="+">0</span></b><small>Global destinations</small></div>
        <div class="stat"><b><span data-count="99.4" data-decimals="1" data-suffix="%">0</span></b><small>On-time dispatch</small></div>
        <div class="stat"><b><span data-count="24" data-suffix="/7">0</span></b><small>Human support</small></div>
    </div>
    <div class="booking-layout mt-4">
        <div class="panel reveal">
            <span class="eyebrow">Our promise</span>
            <h2 style="font-size:1.5rem">Travel with confidence</h2>
            <p class="text-muted">SkyPulse combines modern reservation technology with airline-grade service. From flexible fare holds to simple post-booking changes, every part of the experience is designed around your time.</p>
            <ul class="option-feats">
                <li><svg viewBox="0 0 24 24"><path d="M9 16.2l-3.5-3.5-1.4 1.4 4.9 4.9L20.3 7.7l-1.4-1.4z"/></svg>Transparent pricing — taxes and fees always included</li>
                <li><svg viewBox="0 0 24 24"><path d="M9 16.2l-3.5-3.5-1.4 1.4 4.9 4.9L20.3 7.7l-1.4-1.4z"/></svg>Policy-based refunds calculated automatically</li>
                <li><svg viewBox="0 0 24 24"><path d="M9 16.2l-3.5-3.5-1.4 1.4 4.9 4.9L20.3 7.7l-1.4-1.4z"/></svg>Proactive notifications for schedule changes</li>
            </ul>
        </div>
        <aside class="booking-aside">
            <div class="offer-card offer-solid reveal" style="min-height:320px">
                <span class="eyebrow on-dark">Modern fleet</span>
                <h3 style="font-size:1.3rem">Efficiency at every altitude</h3>
                <p>Our next-generation aircraft deliver quieter cabins and lower emissions on every route.</p>
            </div>
        </aside>
    </div>
</div>