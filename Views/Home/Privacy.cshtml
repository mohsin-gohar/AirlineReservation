@{ ViewData["Title"] = "Privacy Policy"; }
<section class="dark-banner compact">
    <div class="banner-inner">
        <span class="eyebrow on-dark">Your data, respected</span>
        <h1>Privacy policy</h1>
        <p>How SkyPulse collects, uses, and protects your information.</p>
    </div>
</section>
<div class="page page-narrow">
    <div class="panel reveal">
        <span class="eyebrow">Overview</span>
        <h2 style="font-size:1.3rem">What we collect</h2>
        <p class="text-muted">We collect only what is required to operate your journeys: your name, contact details, and trip information (bookings, payments, and SkyMiles activity). Payment card numbers are never stored in full — only a masked reference is retained.</p>
        <span class="eyebrow">How it is used</span>
        <h2 style="font-size:1.3rem">Why we collect it</h2>
        <p class="text-muted">To issue tickets, process policy-based refunds, send booking reminders and schedule-change notifications, and calculate your SkyMiles. We never sell personal data to third parties.</p>
        <span class="eyebrow">Your rights</span>
        <h2 style="font-size:1.3rem">Control your data</h2>
        <p class="text-muted mb-0">You can review and update your profile details at any time from your SkyPulse account, or request deletion by contacting support. Questions? Reach the team via the <a asp-controller="Home" asp-action="Contact">contact page</a>.</p>
    </div>
</div>