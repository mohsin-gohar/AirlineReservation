@model AirlineReservation.Models.FlightStatusViewModel
@using AirlineReservation.Models
@{
    ViewData["Title"] = "Flight Status";
    var f = Model.Flight;
    var indicatorCss = (Model.Indicator) switch
    {
        "Delayed" => "badge-delayed",
        "Cancelled" => "badge-cancelled",
        "Arrived" => "badge-arrived",
        _ => "badge-status"
    };
}
<section class="dark-banner compact">
    <div class="banner-inner">
        <span class="eyebrow on-dark">Live operations</span>
        <h1>Flight status</h1>
        <p>Real-time departure and arrival information for any SkyPulse flight.</p>
    </div>
</section>
<div class="page" style="margin-top:calc(-1*var(--s6))">
    <div class="panel reveal in" style="position:relative;z-index:3;box-shadow:var(--shadow-md)">
        <form asp-action="Status" method="post">
            <div asp-validation-summary="All" class="validation-summary-errors"></div>
            <div class="input-group">
                <div class="field" style="flex:1">
                    <label asp-for="FlightNumber">Flight number</label>
                    <input asp-for="FlightNumber" class="input" placeholder="e.g. AR101" autocomplete="off" />
                    <span asp-validation-for="FlightNumber" class="text-danger"></span>
                </div>
                <div class="field" style="flex:1">
                    <label asp-for="FlightDate">Departure date</label>
                    <input asp-for="FlightDate" class="input" type="date" />
                    <span asp-validation-for="FlightDate" class="text-danger"></span>
                </div>
            </div>
            <div class="search-actions">
                <span class="search-perks"><span><svg viewBox="0 0 24 24"><path d="M12 2l2.9 6.6L22 9.3l-5.4 4.8L18.2 21 12 17.3 5.8 21l1.6-6.9L2 9.3l7.1-.7z"/></svg>Updated live from operations</span></span>
                <button class="btn btn-primary" type="submit">Check status</button>
            </div>
        </form>
    </div>

    @if (f != null)
    {
        <div class="status-card reveal in" style="position:relative;z-index:3;margin-top:var(--s6)">
            <div class="status-head">
                <div>
                    <span class="eyebrow">SkyPulse @f.FlightNumber</span>
                    <h2 style="font-size:1.45rem">@f.OriginCity?.CityName → @f.DestinationCity?.CityName</h2>
                </div>
                <span class="badge-status @indicatorCss">@Model.Indicator</span>
            </div>
            <div class="status-route">
                <div class="pt">
                    <b>@(f.OriginAirport?.Code ?? f.OriginCity?.CityName)</b>
                    <small>@f.OriginAirport?.Name ?? f.OriginCity?.CityName</small>
                    <small class="sub-line">Scheduled departure</small>
                    <strong>@f.DepartureTime.ToString(@"hh\:mm")</strong>
                </div>
                <div class="mid">
                    <small>@f.Duration · non-stop</small>
                    <div class="line"><svg viewBox="0 0 24 24" class="plane"><path d="M21.5 15.5l-8.1-4.7V4.8c0-.9-.6-2.3-1.4-2.3s-1.4 1.4-1.4 2.3v6L2.5 15.5v2.1l8.1-2.5v4.6l-2.2 1.6v1.5l3.6-1 3.6 1v-1.5l-2.2-1.6v-4.6l8.1 2.5v-2.1z"/></svg></div>
                    <small>@f.DepartureDate.ToString("EEE, MMM d, yyyy")</small>
                </div>
                <div class="pt" style="text-align:right">
                    <b>@(f.DestinationAirport?.Code ?? f.DestinationCity?.CityName)</b>
                    <small>@f.DestinationAirport?.Name ?? f.DestinationCity?.CityName</small>
                    <small class="sub-line">Scheduled arrival</small>
                    <strong>@f.ArrivalTime.ToString(@"hh\:mm")</strong>
                </div>
            </div>
            <div class="status-notes">
                @if (f.FlightStatus == FlightStatus.Delayed)
                {
                    <div class="note warn"><svg viewBox="0 0 24 24"><path d="M12 21a9 9 0 119-9 9 9 0 01-9 9zm.5-13.5h-1V12l4 2.4.5-.85-3.5-2.07z"/></svg>This flight is currently <b>delayed</b>. Please arrive early and monitor this page for revised timings.</div>
                }
                else if (f.FlightStatus == FlightStatus.Cancelled)
                {
                    <div class="note danger"><svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5l-9-4z"/></svg>This flight has been <b>cancelled</b>. Contact SkyPulse support or rebook online.</div>
                }
                else
                {
                    <div class="note"><svg viewBox="0 0 24 24"><path d="M9 16.2l-3.5-3.5-1.4 1.4 4.9 4.9L20.3 7.7l-1.4-1.4z"/></svg>Operating as scheduled. Economy seats available: <b>@f.EconomySeats</b> · Business seats available: <b>@f.BusinessSeats</b>.</div>
                }
            </div>
            <div class="bp-actions">
                <a class="btn btn-primary btn-sm" asp-controller="Flight" asp-action="Search">Book this route</a>
                <a class="btn btn-ghost btn-sm" asp-action="Status">New lookup</a>
            </div>
        </div>
    }
</div>