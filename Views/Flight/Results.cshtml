@model IEnumerable<AirlineReservation.Models.Flight>
@using AirlineReservation.Models
@{
    ViewData["Title"] = "Flight Results";
    var search = ViewBag.Search as FlightSearchViewModel;
    var adults = search?.Adults ?? 1;
    var children = search?.Children ?? 0;
    var seniors = search?.Seniors ?? 0;
    var flights = Model ?? Enumerable.Empty<Flight>();
    var bizFares = ViewBag.BusinessFares as List<FlightFare> ?? new List<FlightFare>();
}
<section class="results-head">
    <div class="results-head-inner">
        <div>
            <div class="route-title">@ViewBag.OriginCity <span class="arrow">→</span> @ViewBag.DestinationCity</div>
            <p class="meta">@(search?.DepartureDate.ToString("dddd, MMMM dd, yyyy") ?? "All dates") · @(adults + children + seniors) traveler(s)@(children > 0 ? $" · {children} child" + (children > 1 ? "ren" : "") : "")@(seniors > 0 ? $" · {seniors} senior" + (seniors > 1 ? "s" : "") : "")</p>
        </div>
        <a class="btn btn-ghost btn-sm" asp-action="Search">Edit search</a>
    </div>
</section>
<div class="page">
    <div class="sortbar reveal" role="toolbar" aria-label="Sort and filter flights">
        <span class="label">Sort by</span>
        <button type="button" class="sortbtn" data-sort="price">Price</button>
        <button type="button" class="sortbtn" data-sort="duration">Duration</button>
        <button type="button" class="sortbtn" data-sort="dep">Departure</button>
        <span class="label">Cabin</span>
        <select class="sort-select" id="cabinFilter" data-cabin-filter aria-label="Filter by cabin">
            <option value="all">All cabins</option>
            <option value="eco">Economy</option>
            <option value="biz">Business</option>
        </select>
        <span class="count">@flights.Count() flight(s) found</span>
    </div>
    @if (!flights.Any())
    {
        <div class="empty-state reveal in">
            <div class="icon"><svg viewBox="0 0 24 24"><path d="M21.5 15.5l-8.1-4.7V4.8c0-.9-.6-2.3-1.4-2.3s-1.4 1.4-1.4 2.3v6L2.5 15.5v2.1l8.1-2.5v4.6l-2.2 1.6v1.5l3.6-1 3.6 1v-1.5l-2.2-1.6v-4.6l8.1 2.5v-2.1z"/></svg></div>
            <h3>No flights on this date</h3>
            <p>We couldn't find scheduled flights for this route and date. Try another date or explore a nearby departure.</p>
            <a class="btn btn-primary btn-sm" asp-action="Search">Adjust search</a>
        </div>
    }
    else
    {
        <div class="flight-list" id="flightList">
            @foreach (var f in flights)
            {
                var mins = (int)((f.ArrivalTime - f.DepartureTime).Duration().TotalMinutes);
                var bizFare = bizFares.FirstOrDefault(x => x.FlightSchedule?.FlightId == f.FlightId);
                var bizPrice = bizFare?.CurrentPrice ?? 0m;
                <article class="flight-card reveal" data-price="@f.TicketPrice" data-price-eco="@f.TicketPrice" data-price-biz="@bizPrice" data-duration="@mins" data-dep="@f.DepartureTime.ToString(@"hh\:mm")" data-cabin="eco">
                    <div>
                        <div class="flight-airline">
                            <span class="logo" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21.5 15.5l-8.1-4.7V4.8c0-.9-.6-2.3-1.4-2.3s-1.4 1.4-1.4 2.3v6L2.5 15.5v2.1l8.1-2.5v4.6l-2.2 1.6v1.5l3.6-1 3.6 1v-1.5l-2.2-1.6v-4.6l8.1 2.5v-2.1z"/></svg></span>
                            <span><b>SkyPulse @f.FlightNumber</b><small>@f.Duration · Economy</small></span>
                            <span class="seat-left @(f.EconomySeats >= 20 ? "ok" : "")">@f.EconomySeats seats left</span>
                        </div>
                        <div class="timeline">
                            <div class="tpoint"><b>@f.DepartureTime.ToString(@"hh\:mm")</b><small>@(f.OriginAirport?.Code ?? f.OriginCity?.CityName)</small></div>
                            <div class="tline">
                                <span class="dur">@f.Duration</span>
                                <span class="track"><svg class="plane" viewBox="0 0 24 24"><path d="M21.5 15.5l-8.1-4.7V4.8c0-.9-.6-2.3-1.4-2.3s-1.4 1.4-1.4 2.3v6L2.5 15.5v2.1l8.1-2.5v4.6l-2.2 1.6v1.5l3.6-1 3.6 1v-1.5l-2.2-1.6v-4.6l8.1 2.5v-2.1z"/></svg></span>
                                <span class="stops">Non-stop</span>
                            </div>
                            <div class="tpoint"><b>@f.ArrivalTime.ToString(@"hh\:mm")</b><small>@(f.DestinationAirport?.Code ?? f.DestinationCity?.CityName)</small></div>
                        </div>
                    </div>
                    <div class="flight-price">
                        <small>From, per traveler</small>
                        <span class="amount">@f.TicketPrice.ToString("C")</span>
                        @if (bizPrice > 0m) { <span class="amount-alt">Business from @bizPrice.ToString("C")</span> }
                        <span class="refund"><svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5l-9-4zm-1.2 14.5l-3.6-3.6 1.4-1.4 2.2 2.2 4.6-4.6 1.4 1.4-6 6z"/></svg>Refundable · fare rules apply</span>
                        <a class="btn btn-primary btn-sm" asp-controller="Booking" asp-action="Create" asp-route-flightId="@f.FlightId" asp-route-adults="@adults" asp-route-children="@children" asp-route-seniors="@seniors">Select flight</a>
                    </div>
                </article>
            }
        </div>
    }
</div>