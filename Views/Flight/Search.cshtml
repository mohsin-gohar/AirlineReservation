@model AirlineReservation.Models.FlightSearchViewModel
@{
    ViewData["Title"] = "Search Flights";
    var cities = ViewBag.Cities as List<AirlineReservation.Models.City> ?? new List<AirlineReservation.Models.City>();
}
<section class="dark-banner compact">
    <div class="banner-inner">
        <span class="eyebrow on-dark">Flight discovery</span>
        <h1>Where will you go next?</h1>
        <p>Live schedules, transparent fares, and flexible 14-day fare holds — all in one search.</p>
    </div>
</section>
<div class="search-page-widget">
    <div class="search-widget reveal in">
        <div class="search-tabs" role="tablist" aria-label="Trip type">
            <button type="button" class="search-tab" data-trip-toggle data-trip="roundtrip" data-return-field="ReturnDate" aria-selected="false">
                <svg viewBox="0 0 24 24"><path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/></svg>Round trip
            </button>
            <button type="button" class="search-tab active" data-trip-toggle data-trip="oneway" data-return-field="ReturnDate" aria-selected="true">
                <svg viewBox="0 0 24 24"><path d="M2 12l20-8-6 8 6 8-20-8z"/></svg>One way
            </button>
        </div>
        <form asp-action="Results" method="get" data-skeleton>
            <div class="search-grid">
                <div class="field">
                    <label asp-for="OriginCityId">From</label>
                    <select asp-for="OriginCityId" class="input" required>
                        <option value="" disabled selected>Select origin</option>
                        @foreach (var c in cities) { <option value="@c.CityId">@c.CityName</option> }
                    </select>
                    <span asp-validation-for="OriginCityId" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="DestinationCityId">To</label>
                    <select asp-for="DestinationCityId" class="input" required>
                        <option value="" disabled selected>Select destination</option>
                        @foreach (var c in cities) { <option value="@c.CityId">@c.CityName</option> }
                    </select>
                    <span asp-validation-for="DestinationCityId" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="DepartureDate">Depart</label>
                    <input asp-for="DepartureDate" class="input" type="date" data-min-today />
                    <span asp-validation-for="DepartureDate" class="text-danger"></span>
                </div>
                <div class="field">
                    <label asp-for="ReturnDate">Return</label>
                    <input asp-for="ReturnDate" class="input" type="date" data-min-today />
                    <span asp-validation-for="ReturnDate" class="text-danger"></span>
                </div>
                <div class="field">
                    <label>Travelers</label>
                    <div class="pax-field">
                        <select asp-for="Adults" class="input" aria-label="Adults">@for (var i = 1; i <= 6; i++) { <option value="@i">@(i) ad</option> }</select>
                        <select asp-for="Children" class="input" aria-label="Children">@for (var i = 0; i <= 4; i++) { <option value="@i">@(i) ch</option> }</select>
                    </div>
                </div>
            </div>
            <div class="search-actions">
                <div class="search-perks">
                    <span><svg viewBox="0 0 24 24"><path d="M12 2l2.9 6.6L22 9.3l-5.4 4.8L18.2 21 12 17.3 5.8 21l1.6-6.9L2 9.3l7.1-.7z"/></svg>Best-price promise</span>
                    <span><svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5l-9-4z"/></svg>Free fare hold up to 14 days</span>
                </div>
                <button class="btn btn-primary" type="submit">Search flights</button>
            </div>
        </form>
    </div>
</div>
<section class="section">
    <div class="page page-narrow">
        <div class="panel reveal">
            <span class="eyebrow">Traveler tip</span>
            <h3 style="font-size:1.05rem">Plan to pay later? Block the ticket.</h3>
            <p class="text-muted mb-0" style="font-size:.92rem">Any fare on departures more than 14 days away can be held at zero cost. Confirm whenever you're ready — the price and seats stay reserved for you.</p>
        </div>
    </div>
</section>