{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Restore .NET dependencies",
      "type": "shell",
      "command": "dotnet restore",
      "inAgents": true,
      "runOptions": {
        "runOn": "worktreeCreated"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Build AirlineReservation",
      "type": "shell",
      "command": "dotnet build --no-restore",
      "inAgents": true,
      "dependsOn": "Restore .NET dependencies",
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run AirlineReservation",
      "type": "shell",
      "command": "dotnet run --launch-profile http",
      "inAgents": true,
      "problemMatcher": "$msCompile"
    }
  ]
}
