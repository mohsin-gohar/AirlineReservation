@model System.Collections.Generic.List<AirlineReservation.Models.Booking>
@using AirlineReservation.Models
@{ ViewData["Title"] = "Admin Dashboard"; }
<div class="section-head" style="margin-bottom:var(--s3)">
    <div><span class="eyebrow">Operations center</span><h2 style="margin:0">Network overview</h2></div>
    <span class="chip"><svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1010 10A10 10 0 0012 2zm1 15h-2v-2h2zm0-4h-2V7h2z"/></svg>Live</span>
</div>
<div class="kpi-grid">
    <div class="kpi reveal"><span class="ico"><svg viewBox="0 0 24 24"><path d="M21.5 15.5l-8.1-4.7V4.8c0-.9-.6-2.3-1.4-2.3s-1.4 1.4-1.4 2.3v6L2.5 15.5v2.1l8.1-2.5v4.6l-2.2 1.6v1.5l3.6-1 3.6 1v-1.5l-2.2-1.6v-4.6l8.1 2.5v-2.1z"/></svg></span><span><b><span data-count="@ViewBag.Flights">0</span></b><small>Flights</small></span></div>
    <div class="kpi reveal"><span class="ico"><svg viewBox="0 0 24 24"><path d="M20 6h-3V4a2 2 0 00-2-2H9a2 2 0 00-2 2v2H4a2 2 0 00-2 2v11a2 2 0 002 2h16a2 2 0 002-2V8a2 2 0 00-2-2z"/></svg></span><span><b><span data-count="@ViewBag.ActiveBookings">0</span></b><small>Active bookings</small></span></div>
    <div class="kpi reveal"><span class="ico"><svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.5 3.8 10.7 9 12 5.2-1.3 9-6.5 9-12V5l-9-4z"/></svg></span><span><b><span data-count="@ViewBag.BlockedHolds">0</span></b><small>Fare holds</small></span></div>
    <div class="kpi reveal"><span class="ico"><svg viewBox="0 0 24 24"><path d="M12 12a5 5 0 10-5-5 5 5 0 005 5zm0 2c-3.3 0-10 1.7-10 5v3h20v-3c0-3.3-6.7-5-10-5z"/></svg></span><span><b><span data-count="@ViewBag.Users">0</span></b><small>Users</small></span></div>
</div>
<div class="chart-grid">
    <div class="chart-card reveal">
        <h3>Bookings by status</h3>
        @{ var active = (int)ViewBag.ActiveBookings; var blocked = (int)ViewBag.BlockedHolds; var cancelled = Model.Count(b => b.BookingStatus == BookingStatus.Cancelled); }
        <div class="hbar"><div class="meta"><span>Active</span><span>@active</span></div><div class="track"><div class="fill green" data-width="@(Math.Min(100, active * 10))"></div></div></div>
        <div class="hbar"><div class="meta"><span>Blocked (holds)</span><span>@blocked</span></div><div class="track"><div class="fill amber" data-width="@(Math.Min(100, blocked * 10))"></div></div></div>
        <div class="hbar" style="margin-bottom:0"><div class="meta"><span>Cancelled</span><span>@cancelled</span></div><div class="track"><div class="fill red" data-width="@(Math.Min(100, cancelled * 10))"></div></div></div>
    </div>
    <div class="chart-card reveal">
        <h3>Revenue vs refunds</h3>
        @{ var revenue = (decimal)ViewBag.Revenue; var refunds = (decimal)ViewBag.Refunds; var max = Math.Max(revenue, refunds); if (max <= 0) { max = 1; } }
        <div class="hbar"><div class="meta"><span>Collected</span><span>@revenue.ToString("C")</span></div><div class="track"><div class="fill" data-width="@(Math.Round(revenue / max * 100))"></div></div></div>
        <div class="hbar" style="margin-bottom:0"><div class="meta"><span>Refunded</span><span>@refunds.ToString("C")</span></div><div class="track"><div class="fill red" data-width="@(Math.Round(refunds / max * 100))"></div></div></div>
        <p class="hint mt-4 mb-0" style="margin-top:16px">Net position: <b style="color:var(--ink-900)">@((revenue - refunds).ToString("C"))</b></p>
    </div>
</div>
<div class="admin-panel reveal">
    <div class="panel-head">
        <h3>Recent bookings</h3>
        <a class="btn btn-ghost btn-sm" asp-area="Admin" asp-controller="Bookings" asp-action="Index">View all</a>
    </div>
    <table class="data-table">
        <thead><tr><th>Reference</th><th>Passenger</th><th>Flight</th><th>Status</th><th>Total</th></tr></thead>
        <tbody>
            @foreach (var b in Model)
            {
                var badge = b.BookingStatus switch { BookingStatus.Active => b.BookingType == BookingType.Blocked ? "badge-blocked" : "badge-confirmed", BookingStatus.Cancelled => "badge-cancelled", _ => "badge-rescheduled" };
                <tr>
                    <td><span class="ref-chip">@(b.ConfirmationNumber ?? b.BlockingNumber)</span></td>
                    <td><div class="user-cell"><span class="avatar-dot">@(string.Join("", (b.User?.FirstName ?? "U").Take(1)) + string.Join("", (b.User?.LastName ?? "K").Take(1)))</span><span><b>@b.User?.FirstName @b.User?.LastName</b><small>@b.User?.Email</small></span></div></td>
                    <td>@b.Flight?.FlightNumber · @b.Flight?.OriginCity?.CityName → @b.Flight?.DestinationCity?.CityName</td>
                    <td><span class="badge-status @badge">@b.BookingStatus</span></td>
                    <td class="price-cell">@b.TotalPrice.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>
</div>