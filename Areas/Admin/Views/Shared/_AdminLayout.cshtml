@using Microsoft.AspNetCore.Http
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var uname = Context.Session.GetString("UserName") ?? "Administrator";
    var initials = string.Join("", uname.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(p => p[0])).ToUpperInvariant();
    string Active(string c) => controller == c ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " · " : "")SkyPulse Operations</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/motion.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <style>#adminScrim{position:fixed;inset:0;background:rgba(5,13,31,.55);z-index:1150;opacity:0;pointer-events:none;transition:opacity .3s}#adminScrim.on{opacity:1;pointer-events:auto}</style>
</head>
<body class="admin-body" data-toast-message="@TempData["Message"]" data-toast-error="@TempData["Error"]">
<div class="admin-shell">
    <aside class="admin-sidebar" aria-label="Admin navigation">
        <a class="admin-brand" asp-area="" asp-controller="Home" asp-action="Index">
            <span class="brand-logo" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M21.5 15.5l-8.1-4.7V4.8c0-.9-.6-2.3-1.4-2.3s-1.4 1.4-1.4 2.3v6L2.5 15.5v2.1l8.1-2.5v4.6l-2.2 1.6v1.5l3.6-1 3.6 1v-1.5l-2.2-1.6v-4.6l8.1 2.5v-2.1z"/></svg></span>
            <span><span class="brand-name">SkyPulse</span><span class="brand-sub">OPERATIONS</span></span>
        </a>
        <nav class="admin-nav">
            <span class="group">Manage</span>
            <a class="@Active("Dashboard")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><svg viewBox="0 0 24 24"><path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/></svg>Dashboard</a>
            <a class="@Active("Flights")" asp-area="Admin" asp-controller="Flights" asp-action="Index"><svg viewBox="0 0 24 24"><path d="M21.5 15.5l-8.1-4.7V4.8c0-.9-.6-2.3-1.4-2.3s-1.4 1.4-1.4 2.3v6L2.5 15.5v2.1l8.1-2.5v4.6l-2.2 1.6v1.5l3.6-1 3.6 1v-1.5l-2.2-1.6v-4.6l8.1 2.5v-2.1z"/></svg>Flights</a>
            <a class="@Active("Bookings")" asp-area="Admin" asp-controller="Bookings" asp-action="Index"><svg viewBox="0 0 24 24"><path d="M20 6h-3V4a2 2 0 00-2-2H9a2 2 0 00-2 2v2H4a2 2 0 00-2 2v11a2 2 0 002 2h16a2 2 0 002-2V8a2 2 0 00-2-2zM9 4h6v2H9V4z"/></svg>Bookings</a>
            <a class="@Active("Users")" asp-area="Admin" asp-controller="Users" asp-action="Index"><svg viewBox="0 0 24 24"><path d="M12 12a5 5 0 10-5-5 5 5 0 005 5zm0 2c-3.3 0-10 1.7-10 5v3h20v-3c0-3.3-6.7-5-10-5z"/></svg>Users</a>
            <a class="@Active("CancellationPolicy")" asp-area="Admin" asp-controller="CancellationPolicy" asp-action="Index"><svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/></svg>Cancellation Policies</a>
            <div class="divider" style="height:1px;background:rgba(255,255,255,.08);margin:12px 0"></div>
            <span class="group">Shortcuts</span>
            <a asp-area="" asp-controller="Home" asp-action="Index"><svg viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 2 2 12h3v8z"/></svg>View website</a>
            <a asp-area="" asp-controller="Account" asp-action="Logout"><svg viewBox="0 0 24 24"><path d="M17 8l-1.4 1.4 1.6 1.6H9v2h8.2l-1.6 1.6L17 16l4-4zm-5-6a10 10 0 00-9.5 6.9l1.9.6A8 8 0 1112 20a7.9 7.9 0 01-3.8-1l-1.5 1.3A10 10 0 1012 2z"/></svg>Sign out</a>
        </nav>
        <div class="admin-user">
            <span class="avatar-dot">@initials</span>
            <span><b>@uname</b><small>Administrator</small></span>
        </div>
    </aside>
    <div id="adminScrim" aria-hidden="true"></div>
    <div class="admin-main">
        <div class="admin-topbar">
            <button class="menu-btn" type="button" data-admin-menu aria-label="Toggle admin menu">☰</button>
            <h1>@ViewData["Title"]</h1>
            <span class="spacer"></span>
            <a class="btn btn-ghost btn-sm" asp-area="" asp-controller="Home" asp-action="Index">View site</a>
        </div>
        <div class="admin-content">
            @RenderBody()
        </div>
    </div>
</div>
<div id="toastStack" aria-live="polite"></div>
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true" aria-labelledby="confirmTitle">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h5 class="modal-title" id="confirmTitle">Please confirm</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
        <div class="modal-body"></div>
        <div class="modal-footer">
            <button type="button" class="btn btn-ghost btn-sm" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-primary btn-sm" id="confirmOk">Yes, continue</button>
        </div>
    </div></div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>